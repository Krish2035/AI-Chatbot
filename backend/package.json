{
  "name": "ai-chatbot-backend",
  "version": "1.0.0",
  "description": "Node.js Express Backend for AI Chatbot with Groq LLM, Hugging Face Embeddings, and PostgreSQL pgvector Memory",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "db:setup": "ts-node src/db/setupDb.ts"
  },
  "dependencies": {
    "@huggingface/inference": "^2.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "groq-sdk": "^0.7.0",
    "mammoth": "^1.12.2",
    "pdf-parse": "^1.1.1",
    "pg": "^8.13.0",
    "pgvector": "^0.2.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
