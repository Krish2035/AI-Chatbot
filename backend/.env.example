# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL with pgvector extension)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_chatbot
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_chatbot
DB_USER=postgres
DB_PASSWORD=postgres

# Groq API Keys (Supports single GROQ_API_KEY or comma-separated GROQ_API_KEYS pool)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=groq/compound

# Hugging Face API Tokens (Supports single HF_TOKEN or comma-separated HF_TOKENS pool)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKENS=hf_token1,hf_token2,hf_token3
HF_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Authentication & Security
JWT_SECRET=your_jwt_secret_here

# High Availability & Database Read Replicas (Optional read replica URL)
DATABASE_READ_REPLICA_URL=

# Redis Cache & BullMQ Queue
REDIS_URL=redis://127.0.0.1:6379

# CDN & Performance Cache Headers
CDN_ENABLED=true

